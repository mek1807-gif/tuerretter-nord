---
import BaseLayout from "../layouts/BaseLayout.astro";
import TrustStrip from "../components/TrustStrip.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import TestimonialsSection from "../components/TestimonialsSection.astro";
import Icon from "../components/Icon.astro";
import { siteConfig } from "../config/site";
import { services } from "../config/services";
import { cities } from "../config/cities";
import { faqItems } from "../config/faq";
import { mainPrice, pricingMeta, emergencyService, travelInfo } from "../config/pricing";
import { faqPageSchema } from "../lib/schema";

const homeFaq = faqItems.slice(0, 6);
const title = `Schlüsseldienst Seevetal – Türöffnung ab 99 € inkl. MwSt. | ${siteConfig.brandName}`;
const description = `Ausgesperrt in Seevetal oder Umgebung? ${siteConfig.brandName} öffnet Ihre Tür schnell und transparent ab 99 € inkl. MwSt. 24/7 erreichbar, Einsatzgebiet ca. 25 km rund um Seevetal. Jetzt anrufen.`;
---

<BaseLayout title={title} description={description} path="/" structuredData={[faqPageSchema(homeFaq)]}>

  <section class="hero">
    <div class="container hero__grid">
      <div>
        <span class="eyebrow"><Icon name="map-pin" class="btn-icon" /> Schlüsseldienst {siteConfig.serviceAreaShort}</span>
        <h1>{siteConfig.brandName} – Schlüsseldienst für Seevetal &amp; Umgebung</h1>
        <p class="hero__sub">
          Ausgesperrt? Wir helfen in Seevetal und Umgebung schnell, zuverlässig und transparent –
          mit möglichst beschädigungsarmer Türöffnung.
        </p>

        <a href={siteConfig.phone.href} class="hero__phone" data-cta="hero-phone">
          <span>
            <span class="hero__phone-label">Sofort erreichbar</span>
            <Icon name="phone" class="btn-icon" /> {siteConfig.phone.display}
          </span>
        </a>

        <div class="hero__cta-row">
          <a href={siteConfig.phone.href} class="btn btn--primary btn--lg" data-cta="hero-call">
            <Icon name="phone" class="btn-icon" /> Jetzt anrufen
          </a>
          <a href="/preise" class="btn btn--secondary btn--lg" data-cta="hero-prices">
            <Icon name="euro" class="btn-icon" /> Unsere Preise
          </a>
        </div>

        <ul class="hero__facts">
          <li><Icon name="euro" /> Türöffnung ab 99 € inkl. MwSt.</li>
          <li><Icon name="clock" /> 24/7 erreichbar</li>
          <li><Icon name="map-pin" /> ca. 25 km rund um Seevetal</li>
          <li><Icon name="shield-check" /> Möglichst beschädigungsarme Öffnung</li>
        </ul>
      </div>

      <div>
        <img
          src="/images/hero.webp"
          width="1600"
          height="900"
          alt="Schlüssel steckt in einem Türschloss – Nahaufnahme mit warmem Licht"
          class="hero__image"
          fetchpriority="high"
        />
        <div class="price-box" style="margin-top:1.5rem;">
          <p class="price-box__label">Unser Hauptangebot</p>
          <p class="price-box__title">{mainPrice.label}</p>
          <p class="price-box__amount">{mainPrice.price} <span class="price-box__currency">{pricingMeta.currency}</span> <span style="font-size:0.9rem;font-weight:600;color:var(--color-text-muted);">{mainPrice.priceSuffix}</span></p>
          <ul class="list-check" style="margin-top:0.75rem;font-size:0.9rem;">
            <li><Icon name="check" /> Anfahrt bis {travelInfo.includedKm} km inklusive</li>
            <li><Icon name="check" /> Transparente Preisabsprache</li>
          </ul>
          <p class="price-box__note" style="margin-top:0.75rem;">{mainPrice.description}</p>
          <div style="margin-top:0.75rem;padding-top:0.75rem;border-top:1px solid var(--color-border);font-size:0.85rem;">
            <strong>Notdienst {emergencyService.timeRange}:</strong> {emergencyService.price} {pricingMeta.currency} {emergencyService.priceSuffix}<br />
            <strong>Weitere Anfahrt:</strong> ab dem {travelInfo.includedKm + 1}. km {travelInfo.perExtraKm} je km.
          </div>
        </div>
      </div>
    </div>
  </section>

  <TrustStrip />

  <section class="section" aria-labelledby="leistungen-heading">
    <div class="container">
      <div class="section-head section-head--center">
        <span class="eyebrow">Unsere Leistungen</span>
        <h2 id="leistungen-heading">Wobei wir Ihnen helfen</h2>
        <p class="text-muted">
          Von der zugefallenen Wohnungstür bis zum vorsorglichen Schlosswechsel –
          hier finden Sie unsere wichtigsten Leistungen im Überblick.
        </p>
      </div>

      <div class="grid grid--3">
        {services.map((service) => (
          <a href={`/leistungen/${service.slug}`} class="card card--service">
            <span class="card__icon"><Icon name={service.icon} /></span>
            <h3>{service.title}</h3>
            <p>{service.teaser}</p>
            <span class="card__link">Mehr erfahren <Icon name="arrow-right" class="btn-icon" /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--muted" aria-labelledby="preise-heading">
    <div class="container">
      <div class="two-col">
        <div>
          <span class="eyebrow">Transparente Preise</span>
          <h2 id="preise-heading">Klarer Preis statt böser Überraschungen</h2>
          <p>
            Wir nennen Ihnen Kosten so früh wie möglich – nach Möglichkeit bereits am Telefon und
            in jedem Fall vor Beginn der eigentlichen Arbeiten. Eine reguläre Türöffnung kostet ab 99 € inkl. MwSt.
            Zusätzliche Leistungen werden separat und transparent besprochen.
          </p>
          <ul class="list-check">
            <li><Icon name="check" /> Türöffnung ab 99 € inkl. MwSt. – Anfahrt bis 15 km inklusive</li>
            <li><Icon name="check" /> Keine versteckten Kosten oder erfundenen Zuschläge</li>
            <li><Icon name="check" /> Zusatzleistungen werden vorab besprochen</li>
            <li><Icon name="check" /> Nachvollziehbare Rechnung</li>
          </ul>
          <div class="hero__cta-row">
            <a href="/preise" class="btn btn--secondary">Alle Preise ansehen</a>
            <a href={siteConfig.phone.href} class="btn btn--primary">
              <Icon name="phone" class="btn-icon" /> Jetzt anrufen
            </a>
          </div>
        </div>

        <div>
          <img
            src="/images/schluesselbund.webp"
            width="1200"
            height="800"
            alt="Schlüsselbund mit mehreren Metallschlüsseln auf einer Unterlage"
            class="price-image"
            loading="lazy"
          />
          <div class="price-box" style="margin-top:1.5rem;">
            <p class="price-box__label">Hauptangebot</p>
            <p class="price-box__title">{mainPrice.label}</p>
            <p class="price-box__amount">{mainPrice.price} <span class="price-box__currency">{pricingMeta.currency}</span> <span style="font-size:0.9rem;font-weight:600;color:var(--color-text-muted);">{mainPrice.priceSuffix}</span></p>
            <p class="price-box__note">{mainPrice.description}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="gebiete-heading">
    <div class="container">
      <div class="section-head section-head--center">
        <span class="eyebrow">Einsatzgebiete</span>
        <h2 id="gebiete-heading">Schlüsseldienst in Ihrer Nähe</h2>
        <p class="text-muted">{siteConfig.serviceAreaLong}</p>
      </div>
      <div class="grid grid--4">
        {cities.map((city) => (
          <a href={`/schluesseldienst-${city.slug}`} class="card card--service">
            <span class="card__icon"><Icon name="map-pin" /></span>
            <h3>{city.name}</h3>
            <p>Schlüsseldienst &amp; Türöffnung in {city.name}</p>
            <span class="card__link">Details <Icon name="arrow-right" class="btn-icon" /></span>
          </a>
        ))}
      </div>
      <p class="text-center" style="margin-top:1.5rem;">
        <a href="/einsatzgebiete">Alle Einsatzgebiete im Überblick →</a>
      </p>
    </div>
  </section>

  <section class="section section--muted" aria-labelledby="vertrauen-heading">
    <div class="container">
      <div class="section-head section-head--center">
        <span class="eyebrow">Vertrauen</span>
        <h2 id="vertrauen-heading">Kundenstimmen</h2>
      </div>
      <TestimonialsSection />
    </div>
  </section>

  <section class="section" aria-labelledby="faq-heading">
    <div class="container">
      <div class="section-head section-head--center">
        <span class="eyebrow">Häufige Fragen</span>
        <h2 id="faq-heading">Gut zu wissen</h2>
      </div>
      <div style="max-width:760px;margin-inline:auto;">
        <FaqAccordion items={homeFaq} />
      </div>
      <p class="text-center" style="margin-top:1.5rem;">
        <a href="/faq">Alle Fragen &amp; Antworten →</a>
      </p>
    </div>
  </section>

  <section class="section--dark" style="padding-block:clamp(2.5rem,6vw,4rem);">
    <div class="container text-center">
      <h2>Jetzt ausgesperrt? Wir sind für Sie da.</h2>
      <p style="max-width:560px;margin-inline:auto;color:var(--color-slate-200);">
        Rufen Sie uns direkt an – wir schätzen Ihre Situation ehrlich ein und nennen Ihnen die voraussichtlichen Kosten.
        Türöffnung ab 99 € inkl. MwSt., transparent und ohne versteckte Zuschläge.
      </p>
      <div class="hero__cta-row" style="justify-content:center;">
        <a href={siteConfig.phone.href} class="btn btn--primary btn--lg">
          <Icon name="phone" class="btn-icon" /> {siteConfig.phone.display}
        </a>
        <a href="/preise" class="btn btn--outline-light btn--lg">
          <Icon name="euro" class="btn-icon" /> Preise ansehen
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
