---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import Icon from "../components/Icon.astro";
import { siteConfig } from "../config/site";
import { cities } from "../config/cities";
import { services } from "../config/services";
import { faqItems } from "../config/faq";
import { mainPrice, pricingMeta } from "../config/pricing";
import { serviceSchema } from "../lib/schema";

export function getStaticPaths() {
  return cities.map((city) => ({
    params: { city: city.slug },
    props: { city },
  }));
}

const { city } = Astro.props;
const path = `/schluesseldienst-${city.slug}`;
const localFaq = [
  {
    id: "lokal-einsatzgebiet",
    question: `In welchen Stadtteilen von ${city.name} sind Sie im Einsatz?`,
    answer: `Wir sind in ganz ${city.name} im Einsatz, unter anderem in ${city.districts.join(", ")}. Bei Unsicherheit rufen Sie uns gerne an – wir sagen Ihnen ehrlich, ob und wie schnell wir bei Ihnen sein können.`,
  },
  {
    id: "lokal-preis",
    question: `Was kostet eine Türöffnung in ${city.name}?`,
    answer: `Eine reguläre Türöffnung kostet 99 €. Zusätzliche Leistungen wie ein Schlosswechsel oder ein neuer Schließzylinder werden separat berechnet und vor Beginn der Arbeiten transparent mit Ihnen besprochen.`,
  },
  ...faqItems.filter((item) => ["reaktionszeit", "beschaedigungsfrei"].includes(item.id)),
];
---

<BaseLayout
  title={city.metaTitle}
  description={city.metaDescription}
  path={path}
  structuredData={[
    serviceSchema({
      name: `Schlüsseldienst ${city.name}`,
      description: city.metaDescription,
      url: new URL(path, siteConfig.url).toString(),
    }),
  ]}
>
  <Breadcrumbs
    items={[
      { label: "Start", href: "/" },
      { label: "Einsatzgebiete", href: "/einsatzgebiete" },
      { label: city.name, href: path },
    ]}
  />

  <section class="hero" style="padding-block:clamp(2rem,5vw,3.5rem);">
    <div class="container">
      <span class="eyebrow"><Icon name="map-pin" class="btn-icon" /> {city.region}</span>
      <h1>{city.h1}</h1>
      <p class="hero__sub">{city.intro}</p>
      <div class="hero__cta-row">
        <a href={siteConfig.phone.href} class="btn btn--primary btn--lg">
          <Icon name="phone" class="btn-icon" /> Jetzt anrufen
        </a>
        <a href="/preise" class="btn btn--secondary btn--lg">
          <Icon name="euro" class="btn-icon" /> Preise ansehen
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container two-col">
      <div>
        <h2>Schlüsseldienst vor Ort in {city.name}</h2>
        {city.localNotes.map((note) => <p>{note}</p>)}

        <h3>Typische Stadtteile in unserem Einsatzgebiet</h3>
        <ul class="list-check">
          {city.districts.map((district) => (
            <li><Icon name="map-pin" /> {district}</li>
          ))}
        </ul>

        <h3>Ankunftszeit in {city.name}</h3>
        <p>{city.responseTimeNote}</p>

        <h2>Unsere Leistungen in {city.name}</h2>
        <div class="grid grid--3">
          {services.slice(0, 6).map((service) => (
            <a href={`/leistungen/${service.slug}`} class="card card--service">
              <span class="card__icon"><Icon name={service.icon} /></span>
              <h3 style="font-size:1.05rem;">{service.title}</h3>
              <p style="font-size:0.9rem;">{service.teaser}</p>
            </a>
          ))}
        </div>
      </div>

      <aside class="stack">
        <div class="price-box">
          <p class="price-box__label">Türöffnung</p>
          <p class="price-box__amount">{mainPrice.price}<span class="price-box__currency">{pricingMeta.currency}</span></p>
          <p class="price-box__note">{mainPrice.description}</p>
        </div>

        <div class="hero__card" style="background:var(--color-navy-900);border-radius:var(--radius-lg);">
          <h2 style="color:var(--color-white);">Türe zu, Hilfe nah</h2>
          <p style="color:var(--color-slate-200);font-size:0.92rem;">
            Rufen Sie uns an – wir helfen Ihnen in {city.name} schnell und zuverlässig weiter.
          </p>
          <a href={siteConfig.phone.href} class="btn btn--primary btn--block" style="margin-bottom:0.75rem;">
            <Icon name="phone" class="btn-icon" /> {siteConfig.phone.display}
          </a>
          <a href="/kontakt" class="btn btn--outline-light btn--block">
            <Icon name="message-circle" class="btn-icon" /> Kontaktformular
          </a>
        </div>

        <a href="/preise" style="font-size:0.9rem;">Alle Preise &amp; Zusatzleistungen ansehen →</a>
      </aside>
    </div>
  </section>

  <section class="section section--muted">
    <div class="container">
      <h2>Häufige Fragen zum Schlüsseldienst in {city.name}</h2>
      <div style="max-width:760px;">
        <FaqAccordion items={localFaq} />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Weitere Einsatzgebiete</h2>
      <div class="grid grid--4">
        {cities.filter((c) => c.slug !== city.slug).map((other) => (
          <a href={`/schluesseldienst-${other.slug}`} class="card card--service">
            <span class="card__icon"><Icon name="map-pin" /></span>
            <h3 style="font-size:1rem;">{other.name}</h3>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
