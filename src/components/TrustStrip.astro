---
import Icon from "./Icon.astro";

const items = [
  { icon: "euro" as const, label: "Transparente Preise vorab" },
  { icon: "shield-check" as const, label: "Seriöse, professionelle Arbeitsweise" },
  { icon: "clock" as const, label: "Schnelle Einsatzbereitschaft" },
  { icon: "receipt" as const, label: "Nachvollziehbare Rechnung" },
];
---

<div class="trust-strip">
  <div class="container">
    <ul class="trust-strip__list">
      {items.map((item) => (
        <li class="trust-strip__item">
          <Icon name={item.icon} />
          <span>{item.label}</span>
        </li>
      ))}
    </ul>
  </div>
</div>
