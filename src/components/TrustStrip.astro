---
import Icon from "./Icon.astro";

const items = [
  { icon: "euro" as const, label: "Türöffnung ab 99 € inkl. MwSt." },
  { icon: "shield-check" as const, label: "Möglichst beschädigungsarme Öffnung" },
  { icon: "clock" as const, label: "24/7 erreichbar" },
  { icon: "receipt" as const, label: "Transparente Kommunikation & Rechnung" },
];
---

<div class="trust-strip">
  <div class="container">
    <ul class="trust-strip__list">
      {items.map((item) => (
        <li class="trust-strip__item">
          <Icon name={item.icon} />
          <span>{item.label}</span>
        </li>
      ))}
    </ul>
  </div>
</div>
