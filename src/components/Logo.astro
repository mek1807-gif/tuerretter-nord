---
/**
 * Logo.astro – Wortmarke "Türretter-Nord" mit dezentem Schild/Schlüssel-Motiv.
 * Helles Design: dunkelblauer Hintergrund mit goldenem Schild und weißem Schlüssel.
 * Reines Inline-SVG -> kein zusätzlicher Bild-Request, beliebig skalierbar.
 */
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 40 40"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label="Türretter-Nord Logo"
>
  <rect width="40" height="40" rx="10" fill="#122a47" />
  <path
    d="M20 7.5 12 10.5v7.2c0 6.2 3.9 10.7 8 12.3 4.1-1.6 8-6.1 8-12.3v-7.2L20 7.5Z"
    fill="none"
    stroke="#f5c44d"
    stroke-width="1.8"
    stroke-linejoin="round"
  />
  <circle cx="20" cy="18" r="3.1" fill="none" stroke="#FFFFFF" stroke-width="1.6" />
  <path d="M20 21.1V25.5" stroke="#FFFFFF" stroke-width="1.6" stroke-linecap="round" />
  <path d="M20 23.4h2" stroke="#FFFFFF" stroke-width="1.6" stroke-linecap="round" />
  <path d="M20 25.5h1.6" stroke="#FFFFFF" stroke-width="1.6" stroke-linecap="round" />
</svg>
